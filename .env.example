# MJCC Flutter - template for build-time API configuration
#
# Copy this file to ".env" and adjust the values for your environment, then
# build with:
#   flutter build apk --release --dart-define-from-file=.env
#
# Values are baked into the APK at build time, so any change here requires
# a rebuild of the APK.

# Development: Laravel backend on the local network (LAN).
API_BASE_URL=http://192.168.1.5:8000

# Production: replace with the real domain when deploying.
# API_BASE_URL=https://api.morowali.go.id